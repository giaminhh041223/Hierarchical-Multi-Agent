{
  "_doc": "Adapter manifests. run/resume = args after the binary; {model} {session} {out} {schema} (file) {schema_json} (inline) {prompt} {mode} are filled per call. mode.rw = worker edits, mode.ro = read-only/plan (lead, reviewer, probes). prompt: stdin | arg. verified = flags tested on this machine.",
  "codex": {
    "name": "OpenAI Codex CLI", "bin": "codex", "verified": true,
    "auth_files": ["~/.codex/auth.json"], "auth_env": ["OPENAI_API_KEY", "CODEX_API_KEY"],
    "login": ["login"], "models_from": "codex_cache", "usage": "codex_rollouts",
    "mode": {"rw": "workspace-write", "ro": "read-only"},
    "run": ["-a", "never", "exec", "--json", "--skip-git-repo-check", "-s", "{mode}", "-m", "{model}", "-o", "{out}", "--output-schema", "{schema}", "-"],
    "resume": ["-a", "never", "exec", "resume", "{session}", "--json", "--skip-git-repo-check", "-c", "sandbox_mode=\"{mode}\"", "-m", "{model}", "-o", "{out}", "--output-schema", "{schema}", "-"],
    "prompt": "stdin", "parse": "codex"
  },
  "claude": {
    "name": "Claude Code", "bin": "claude", "verified": false,
    "auth_files": ["~/.claude/.credentials.json"], "auth_env": ["ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN"],
    "login": [], "login_hint": "type /login in the window that opens",
    "models": ["claude-opus-5-5", "claude-sonnet-5-5", "claude-fable-5-1", "claude-haiku-4-5"],
    "mode": {"rw": "acceptEdits", "ro": "plan"},
    "run": ["-p", "--output-format", "json", "--model", "{model}", "--permission-mode", "{mode}", "--allowedTools", "Bash,Read,Edit,Write,Glob,Grep", "--json-schema", "{schema_json}"],
    "resume": ["-p", "--output-format", "json", "--model", "{model}", "--permission-mode", "{mode}", "--allowedTools", "Bash,Read,Edit,Write,Glob,Grep", "--json-schema", "{schema_json}", "--resume", "{session}"],
    "prompt": "stdin", "parse": "claude", "unset_env": ["CLAUDECODE", "CLAUDE_CODE_ENTRYPOINT"]
  },
  "claude@zai": {
    "name": "Claude Code -> Z.ai GLM (Anthropic-compatible endpoint)", "base": "claude", "verified": false,
    "needs_vault": ["ZAI_API_KEY"],
    "env": {"ANTHROPIC_BASE_URL": "https://api.z.ai/api/anthropic", "ANTHROPIC_AUTH_TOKEN": "{vault:ZAI_API_KEY}"},
    "models": ["glm-5.3", "glm-5.2"]
  },
  "agy": {
    "name": "Google Antigravity CLI", "bin": "agy", "verified": true,
    "auth_files": ["~/.gemini/antigravity"], "login": [], "login_hint": "sign in when the CLI asks",
    "models_cmd": ["models"], "probe_model": "gemini-3.8-flash-low",
    "mode": {"rw": "accept-edits", "ro": "plan"},
    "run": ["--output-format", "json", "--model", "{model}", "--mode", "{mode}", "--json-schema", "{schema}", "-p", "{prompt}"],
    "resume": ["--output-format", "json", "--model", "{model}", "--mode", "{mode}", "--json-schema", "{schema}", "--conversation", "{session}", "-p", "{prompt}"],
    "prompt": "arg", "parse": "agy",
    "note": "## This CLI cannot run commands\nShell commands are denied in this mode: do not try to run tests, scripts or orch commands. Read files (and edit them if your role allows), then reply with the JSON output contract; the engine runs the verify commands itself."
  },
  "opencode": {
    "name": "OpenCode", "bin": "opencode", "verified": true,
    "auth_files": ["~/.local/share/opencode/auth.json"], "login": ["auth", "login"],
    "models_cmd": ["models"], "mode": {"rw": "build", "ro": "plan"},
    "run": ["run", "--format", "json", "--agent", "{mode}", "-m", "{model}", "{prompt}"],
    "resume": ["run", "--format", "json", "--agent", "{mode}", "-m", "{model}", "--session", "{session}", "{prompt}"],
    "prompt": "arg", "parse": "opencode"
  },
  "opencode@free": {
    "name": "OpenCode Zen free models (no account; own data dir, no user plugins)", "base": "opencode",
    "env": {"XDG_DATA_HOME": "{home}/opencode-free"}, "auth_files": [], "login": null, "probe_model": "opencode/big-pickle", "free": true,
    "run": ["run", "--pure", "--format", "json", "--agent", "{mode}", "-m", "{model}", "{prompt}"],
    "resume": ["run", "--pure", "--format", "json", "--agent", "{mode}", "-m", "{model}", "--session", "{session}", "{prompt}"]
  },
  "opencode@9router": {
    "name": "OpenCode via 9router (local OpenAI-compatible router, github.com/decolua/9router)", "base": "opencode", "verified": false,
    "router": "http://127.0.0.1:20128/v1", "router_headers": {"X-9Router-Token-Saver": "off"},
    "models_from": "router", "models_cmd": null, "needs_vault": ["NINEROUTER_API_KEY"], "auth_files": [], "login": null,
    "login_hint": "connect providers and create an API key on the 9router dashboard (http://127.0.0.1:20128), then: python -m orch vault set NINEROUTER_API_KEY",
    "env": {"XDG_DATA_HOME": "{home}/opencode-9router", "ROUTER_API_KEY": "{vault:NINEROUTER_API_KEY}"},
    "run": ["run", "--pure", "--format", "json", "--agent", "{mode}", "-m", "router/{model}", "{prompt}"],
    "resume": ["run", "--pure", "--format", "json", "--agent", "{mode}", "-m", "router/{model}", "--session", "{session}", "{prompt}"]
  },
  "gemini": {
    "name": "Gemini CLI", "bin": "gemini", "verified": false, "install": "npm i -g @google/gemini-cli",
    "auth_files": ["~/.gemini/oauth_creds.json"], "auth_env": ["GEMINI_API_KEY"], "login": [],
    "models": ["gemini-3.1-pro", "gemini-3.8-flash"],
    "mode": {"rw": "auto_edit", "ro": "plan"},
    "run": ["--output-format", "json", "-m", "{model}", "--approval-mode", "{mode}", "-p", "{prompt}"],
    "prompt": "arg", "parse": "gemini"
  },
  "cursor-agent": {
    "name": "Cursor CLI", "bin": "cursor-agent", "verified": false, "install": "see cursor.com/cli",
    "auth_env": ["CURSOR_API_KEY"], "login": ["login"], "models": ["auto"],
    "run": ["-p", "--output-format", "json", "--model", "{model}", "{prompt}"],
    "prompt": "arg", "parse": "claude"
  },
  "mock": {
    "name": "Mock agent (zero-cost tests)", "bin": "python", "verified": true, "hidden": true,
    "models": ["mock-strong", "mock-fast"], "mode": {"rw": "rw", "ro": "ro"},
    "run": ["-m", "orch.mock", "{model}"], "resume": ["-m", "orch.mock", "{model}", "{session}"],
    "prompt": "stdin", "parse": "agy"
  },
  "mock@b": {"name": "Mock agent, second account (tests)", "base": "mock"},
  "mock@c": {"name": "Mock agent, third account (tests)", "base": "mock"}
}
